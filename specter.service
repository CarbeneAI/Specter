[Unit]
Description=Specter Security Dashboard
Documentation=https://github.com/CarbeneAI/Specter
After=network.target

[Service]
Type=simple
# Replace with your actual username
User=YOUR_USERNAME
Group=YOUR_USERNAME
WorkingDirectory=/path/to/Specter
ExecStart="/path/to/Specter/start-specter.sh"
Restart=on-failure
RestartSec=10
TimeoutStopSec=15
KillMode=control-group
KillSignal=SIGTERM

# Replace HOME with the service user's actual home. The launcher adds
# ${BUN_INSTALL:-$HOME/.bun}/bin to PATH and exports the checkout's .env.
Environment="HOME=/home/YOUR_USERNAME"
Environment="PATH=/usr/local/bin:/usr/bin:/bin"

# Logging
StandardOutput=journal
StandardError=journal
SyslogIdentifier=specter

[Install]
WantedBy=multi-user.target
