[Unit]
Description=Specter Security Dashboard
Documentation=https://github.com/CarbeneAI/Specter
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# User service: %h is this user's home. Update both paths if the checkout
# lives elsewhere. Quote ExecStart (but not WorkingDirectory) for spaces.
WorkingDirectory=%h/Specter
ExecStart="%h/Specter/start-specter.sh"
Restart=on-failure
RestartSec=10
TimeoutStopSec=15
KillMode=control-group
KillSignal=SIGTERM
Environment="PATH=/usr/local/bin:/usr/bin:/bin"

[Install]
WantedBy=default.target
