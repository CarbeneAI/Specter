# ============================================================
# Specter - Environment Configuration
# Copy this file to .env and fill in your values
# ============================================================

# ------------------------------------------------------------
# Wazuh Connection (REQUIRED)
# ------------------------------------------------------------
# Full URL to your Wazuh Dashboard (includes https://)
WAZUH_DASHBOARD_URL=https://your-wazuh-server

# Wazuh Dashboard admin credentials
WAZUH_DASHBOARD_USER=admin
WAZUH_DASHBOARD_PASSWORD=

# How often to poll Wazuh for new alerts (milliseconds, default 30s)
# WAZUH_POLL_INTERVAL=30000

# Optional: path to a JSONL alerts file (fallback if Wazuh API is unavailable)
# WAZUH_ALERTS_PATH=/path/to/alerts.jsonl

# ------------------------------------------------------------
# Alert Triage Provider
# ------------------------------------------------------------
# Which backend serves alert triage (Analyze / chat with alert context).
#   claude    (DEFAULT) - ssh to Mac Studio and run `claude -p` on Claude Max
#                         $0 marginal cost. No api.anthropic.com calls.
#   ollama              - local Ollama on this host (slow-gen safe)
#   anthropic           - paid Anthropic Messages API (requires credits)
# On claude-cli failure, Specter falls back to ollama automatically.
TRIAGE_PROVIDER=claude

# Claude CLI over SSH (used when TRIAGE_PROVIDER=claude)
# Required when TRIAGE_PROVIDER=claude. user@host of the machine holding the Claude CLI session.
# CLAUDE_CLI_SSH_HOST=user@your-host
# CLAUDE_CLI_BIN=/opt/homebrew/bin/claude
# CLAUDE_CLI_MODEL=claude-sonnet-5
# CLAUDE_CLI_TIMEOUT_MS=900000

# Historical correlation (optional, both required together).
# Before each triage Specter runs this read-only indexer query itself on
# CLAUDE_CLI_SSH_HOST and injects "has this fired before?" into the prompt, so
# the model never needs a shell. No defaults: this repo is public, so a local
# filesystem layout is never baked in. Unset = triage runs without history.
# QUERY_INDEXER_PATH=/abs/path/on/ssh/host/QueryIndexer.ts
# QUERY_INDEXER_ENV=~/path/to/env-file-with-WAZUH_DASHBOARD_PASSWORD
# QUERY_INDEXER_TIMEOUT_MS=60000

# Local Ollama (used when TRIAGE_PROVIDER=ollama, or as claude-cli fallback)
# OLLAMA_URL=http://localhost:11434
# OLLAMA_MODEL=gemma4:31b

# ------------------------------------------------------------
# Anthropic API (ONLY when TRIAGE_PROVIDER=anthropic)
# ------------------------------------------------------------
# Paid Messages API key. Not used by the default claude-cli path.
# Keep unset on the Studio host that runs `claude -p` or the CLI will
# silently bill this key instead of the Max subscription.
# ANTHROPIC_API_KEY=

# ------------------------------------------------------------
# Alert Mutes (optional)
# Mutes hide alerts in the Specter feed only. The alert still reaches Wazuh
# and stays searchable -- no SSH, no sensor changes. This is the default way
# to quiet known-good noise; upstream suppression (below) is the heavier,
# data-destroying option.
# ------------------------------------------------------------
# Path to the mutes SQLite DB. Default: ./data/mutes.sqlite
# MUTES_DB_PATH=./data/mutes.sqlite

# ------------------------------------------------------------
# Suricata Suppression (Optional)
# Required only if you want to suppress Suricata rules from the dashboard
# Format: user@hostname or user@ip-address
#
# WARNING: this disables the signature at the sensor, so the alert stops
# reaching Wazuh entirely. Leave unset to keep the dashboard mute-only; the
# suppress button will report SURICATA_SSH_HOST not configured, by design.
# ------------------------------------------------------------
SURICATA_SSH_HOST=user@suricata-host

# Path to disable.conf on the remote Suricata host
# SURICATA_DISABLE_CONF_REMOTE=~/suricata/config/disable.conf

# Local copy of disable.conf (managed by Specter)
# SURICATA_DISABLE_CONF_LOCAL=./suricata-disable.conf

# ------------------------------------------------------------
# Wazuh Suppression (Optional)
# Required only if you want to suppress Wazuh rules from the dashboard
# ------------------------------------------------------------
WAZUH_SSH_HOST=user@wazuh-host

# Path to local_rules.xml on the Wazuh server (default is standard location)
# WAZUH_LOCAL_RULES_PATH=/var/ossec/etc/rules/local_rules.xml

# ------------------------------------------------------------
# Server Configuration
# ------------------------------------------------------------
# Port for the Specter API + WebSocket server
PORT=4001

# ------------------------------------------------------------
# Client Configuration (prefix with VITE_ for browser access)
# ------------------------------------------------------------
# API URL for the client to reach the server
VITE_API_URL=http://localhost:4001

# WebSocket URL for real-time alert streaming
VITE_WS_URL=ws://localhost:4001/stream

# ------------------------------------------------------------
# Investigation Ledger (Optional)
# ------------------------------------------------------------
# Path to the ledger SQLite database. Resolved and validated by
# resolveDbPath() in ledger.ts. Default: ./data/ledger.sqlite
# LEDGER_DB_PATH=./data/ledger.sqlite

# ------------------------------------------------------------
# Server (Optional)
# ------------------------------------------------------------
# Port the API/WebSocket server binds to. Default: 4001
# PORT=4001

# Origin allowed by CORS. Must match the URL the dashboard is served from,
# because the client sends credentials. Default: http://localhost:5173
# CORS_ALLOWED_ORIGIN=http://localhost:5173

# Optional key file, for setups that keep credentials outside the repo.
# Only consulted when neither ANTHROPIC_API_KEY nor WAZUH_PAI_API_KEY is set
# in the environment. Default: ~/.claude/.env
# SPECTER_ENV_FILE=/path/to/keyfile.env
